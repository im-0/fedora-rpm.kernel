From ca882ceaecd0b22c56a9d2ceb73f3411bc8b8f1c Mon Sep 17 00:00:00 2001
From: Ivan Mironov <mironov.ivan@gmail.com>
Date: Thu, 29 Jul 2021 10:29:17 +0500
Subject: [PATCH] Input: synaptics - enable InterTouch for ThinkPad T590

This fixes 3-finger gestures in GNOME.

Tested on

	product: 20N4S1T200 (LENOVO_MT_20N4_BU_Think_FM_ThinkPad T590)
	vendor: LENOVO
	version: ThinkPad T590

Signed-off-by: Ivan Mironov <mironov.ivan@gmail.com>
Cc: stable@vger.kernel.org
---
 drivers/input/mouse/synaptics.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/input/mouse/synaptics.c b/drivers/input/mouse/synaptics.c
index c70502e24031..6c39db59deab 100644
--- a/drivers/input/mouse/synaptics.c
+++ b/drivers/input/mouse/synaptics.c
@@ -191,6 +191,7 @@ static const char * const smbus_pnp_ids[] = {
 	"LEN2054", /* E480 */
 	"LEN2055", /* E580 */
 	"LEN2058", /* E490 */
+	"LEN205b", /* Lenovo ThinkPad T590 */
 	"LEN2068", /* T14 Gen 1 */
 	"SYN1221", /* TUXEDO InfinityBook Pro 14 v5 */
 	"SYN3003", /* HP EliteBook 850 G1 */
-- 
2.54.0

