From 3cf41b5470e3c6207df226ed3e0b446d5cbf6b25 Mon Sep 17 00:00:00 2001
From: Ivan Mironov <mironov.ivan@gmail.com>
Date: Sat, 3 Jan 2026 10:55:03 +0100
Subject: [PATCH 7/7] Revert "net: phy: stop exporting phy_driver_unregister"

This reverts commit e211c463b748c4e2e8364c10bc216ca775fcc943.
---
 drivers/net/phy/phy_device.c | 11 ++++++-----
 include/linux/phy.h          |  1 +
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/drivers/net/phy/phy_device.c b/drivers/net/phy/phy_device.c
index 6eb79612785b..3aff9810e3df 100644
--- a/drivers/net/phy/phy_device.c
+++ b/drivers/net/phy/phy_device.c
@@ -3881,11 +3881,6 @@ int phy_driver_register(struct phy_driver *new_driver, struct module *owner)
 }
 EXPORT_SYMBOL(phy_driver_register);
 
-static void phy_driver_unregister(struct phy_driver *drv)
-{
-	driver_unregister(&drv->mdiodrv.driver);
-}
-
 int phy_drivers_register(struct phy_driver *new_driver, int n,
 			 struct module *owner)
 {
@@ -3903,6 +3898,12 @@ int phy_drivers_register(struct phy_driver *new_driver, int n,
 }
 EXPORT_SYMBOL(phy_drivers_register);
 
+void phy_driver_unregister(struct phy_driver *drv)
+{
+	driver_unregister(&drv->mdiodrv.driver);
+}
+EXPORT_SYMBOL(phy_driver_unregister);
+
 void phy_drivers_unregister(struct phy_driver *drv, int n)
 {
 	int i;
diff --git a/include/linux/phy.h b/include/linux/phy.h
index 935b193a0475..e789aafd2087 100644
--- a/include/linux/phy.h
+++ b/include/linux/phy.h
@@ -2362,6 +2362,7 @@ static inline int phy_read_status(struct phy_device *phydev)
 		return genphy_read_status(phydev);
 }
 
+void phy_driver_unregister(struct phy_driver *drv);
 void phy_drivers_unregister(struct phy_driver *drv, int n);
 int phy_driver_register(struct phy_driver *new_driver, struct module *owner);
 int phy_drivers_register(struct phy_driver *new_driver, int n,
-- 
2.55.0

